$ ASCENT-Load VM11: MacNeal-Harder Straight Cantilever Beam (CQUAD4)
$ Reference: MacNeal & Harder, "A Proposed Standard Set of Problems
$   to Test Finite Element Accuracy", FE Anal. Design 1 (1985) 3-20
$
$ Rectangular mesh of 6x1 CQUAD4 elements
$ Length=6.0, Width=0.2, Depth (thickness)=0.1
$ E=1.0e7, nu=0.30
$
$ 2 rows of 7 nodes = 14 nodes, 6 CQUAD4 elements
$ Row 1 (y=-0.1): nodes 1-7, x=0 to 6 (spacing 1.0)
$ Row 2 (y=+0.1): nodes 8-14, x=0 to 6
$
$ Three load cases via separate SUBCASE:
$ Case 1: Out-of-plane shear (P=1.0 in Z) -> exact tip uz = 0.4321
$ Case 2: In-plane shear (P=1.0 in Y) -> exact tip uy = 0.1081
$ Case 3: Extension (P=1.0 in X) -> exact tip ux = 3.0e-5
$
SOL 101
CEND
TITLE = VM11 - MACNEAL-HARDER STRAIGHT BEAM (CQUAD4)
SUBCASE 1
  SUBTITLE = OUT-OF-PLANE SHEAR (Z-FORCE)
  SPC = 1
  LOAD = 1
  DISPLACEMENT(PRINT) = ALL
SUBCASE 2
  SUBTITLE = IN-PLANE SHEAR (Y-FORCE)
  SPC = 1
  LOAD = 2
  DISPLACEMENT(PRINT) = ALL
SUBCASE 3
  SUBTITLE = EXTENSION
  SPC = 1
  LOAD = 3
  DISPLACEMENT(PRINT) = ALL
BEGIN BULK
$
$ Row 1 (y = -0.1)
GRID,1,,0.0,-0.1,0.0
GRID,2,,1.0,-0.1,0.0
GRID,3,,2.0,-0.1,0.0
GRID,4,,3.0,-0.1,0.0
GRID,5,,4.0,-0.1,0.0
GRID,6,,5.0,-0.1,0.0
GRID,7,,6.0,-0.1,0.0
$
$ Row 2 (y = +0.1)
GRID,8,,0.0,0.1,0.0
GRID,9,,1.0,0.1,0.0
GRID,10,,2.0,0.1,0.0
GRID,11,,3.0,0.1,0.0
GRID,12,,4.0,0.1,0.0
GRID,13,,5.0,0.1,0.0
GRID,14,,6.0,0.1,0.0
$
$ 6 CQUAD4 elements
CQUAD4,1,1,1,2,9,8
CQUAD4,2,1,2,3,10,9
CQUAD4,3,1,3,4,11,10
CQUAD4,4,1,4,5,12,11
CQUAD4,5,1,5,6,13,12
CQUAD4,6,1,6,7,14,13
$
PSHELL,1,1,0.1,1
MAT1,1,1.0e7,,0.30,0.0
$
$ Fixed at x=0 (nodes 1, 8)
SPC1,1,123456,1,8
$
$ Case 1: In-plane shear (unit Z-force at tip nodes, 0.5 each)
FORCE,1,7,,0.5,0.0,0.0,1.0
FORCE,1,14,,0.5,0.0,0.0,1.0
$
$ Case 2: Out-of-plane shear (unit Y-force at tip nodes, 0.5 each)
FORCE,2,7,,0.5,0.0,1.0,0.0
FORCE,2,14,,0.5,0.0,1.0,0.0
$
$ Case 3: Extension (unit X-force at tip nodes, 0.5 each)
FORCE,3,7,,0.5,1.0,0.0,0.0
FORCE,3,14,,0.5,1.0,0.0,0.0
$
ENDDATA
